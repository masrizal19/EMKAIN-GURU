# Supabase Client Credentials
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key_here

# Backend Production API Base URL (For static frontend deployment like GitHub Pages)
# e.g., https://api.mkverse.my.id (Leave blank for relative path in local development)
VITE_API_URL=

# Supabase Server-Only Secret (Never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
